# Binance Web3 API credentials. Keep secrets outside source control.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=

# Wallet sign-in. For production, set the public HTTPS origin and a unique random secret of 32+ characters.
MANDATE_APP_ORIGIN=http://127.0.0.1:3110
MANDATE_SESSION_SECRET=

# Optional read-only BNB Smart Chain RPC for block-consistent wallet preflight.
MANDATE_BSC_RPC_URL=

# SPYon wallet transaction pilot. Keep false until a funded mainnet trial and review are complete.
MANDATE_DIRECT_EXECUTION_ENABLED=false

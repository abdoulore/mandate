# Binance Web3 API credentials. Keep secrets outside source control.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=

# Wallet sign-in. For production, set the public HTTPS origin and a unique random secret of 32+ characters.
MANDATE_APP_ORIGIN=http://127.0.0.1:3110
MANDATE_SESSION_SECRET=

# Production PostgreSQL ledger. Leave blank for the local embedded ledger.
MANDATE_DATABASE_URL=

# Optional read-only BNB Smart Chain RPC for block-consistent wallet preflight.
MANDATE_BSC_RPC_URL=

# SPYon pilot. Both stages require this explicit public wallet allowlist.
MANDATE_DIRECT_PILOT_WALLETS=
# Approval-only stage: capped at an exact 1 USDT buy approval when swaps are disabled.
MANDATE_DIRECT_APPROVAL_ENABLED=false
# Wallet-scoped 1 USDT buy-only swap trial after a confirmed exact approval.
MANDATE_DIRECT_SWAP_TRIAL_ENABLED=false
# Separate, one-position sell trial. Pin the hash of a reconciled 1 USDT BUY;
# the server derives the exact sell amount from its verified token receipt.
MANDATE_DIRECT_SELL_TRIAL_ENABLED=false
MANDATE_DIRECT_SELL_TRIAL_BUY_HASH=
# Swap stage stays off until approval, funded simulation, and settlement review pass.
MANDATE_DIRECT_EXECUTION_ENABLED=false
# Experimental wallet-allowlisted plan-bound SPYon buy preparation using a separate SPYon-only trial mandate; the main investment mandate is unchanged.
# Keep off until the phone-based plan and recovery flow is verified.
MANDATE_PLAN_DIRECT_ENABLED=false
